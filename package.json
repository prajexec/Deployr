{
  "name": "deployservice-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter=!apps/web build",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:unit": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "lint": "echo 'Linting skipped'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @deployservice/shared db:generate",
    "db:migrate": "pnpm --filter @deployservice/shared db:migrate"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
