# Environment configuration for DeployService
# Copy this file to .env and replace placeholder values before starting.
# Generate secure random strings for credentials in production (e.g. `openssl rand -hex 16`).

NODE_ENV=development
API_PORT=3000
ROUTER_PORT=8080

# PostgreSQL
# In local dev with docker-compose.dev.yml: localhost:5432
# Inside docker compose network: postgres:5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=deployservice
POSTGRES_USER=<GENERATE_POSTGRES_USER_OR_DEV_DEFAULT>
POSTGRES_PASSWORD=<GENERATE_POSTGRES_PASSWORD_OR_DEV_DEFAULT>
DATABASE_URL=postgresql://<GENERATE_POSTGRES_USER_OR_DEV_DEFAULT>:<GENERATE_POSTGRES_PASSWORD_OR_DEV_DEFAULT>@localhost:5432/deployservice

# Redis
# In local dev with docker-compose.dev.yml: localhost:6379
# Inside docker compose network: redis:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO (S3 compatible)
# In local dev with docker-compose.dev.yml: http://localhost:9000
# Inside docker compose network: http://minio:9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<GENERATE_MINIO_ACCESS_KEY_OR_DEV_DEFAULT>
S3_SECRET_ACCESS_KEY=<GENERATE_MINIO_SECRET_KEY_OR_DEV_DEFAULT>
S3_BUCKET=deployments
S3_FORCE_PATH_STYLE=true

# Worker & Build Limits
MAX_CONCURRENT_BUILDS=2
BUILD_TIMEOUT_MS=300000
MAX_LOG_BYTES=2097152
MAX_REPO_SIZE_MB=100

# Web Dashboard & Authentication
FRONTEND_URL=http://localhost:5173
API_KEY=dev-api-key
